# Copy to .env and fill in (or run `ojs init`). The CLI reads `.env` from the
# current directory, then falls back to ~/.config/ojs/.env (set OJS_CONFIG_PATH
# to point at a different file) for anything unset -- place this file at
# ~/.config/ojs/.env to use one config from any directory.
#
# .env is gitignored; keep it private -- it holds your API token and website
# password. `ojs init` writes it 0600 on POSIX; on a shared host you can also
# `chmod 600 .env`. On Windows, file-mode restriction does not apply -- rely on
# directory/ACL access control.

# Required for the `ojs api` commands
OJS_BASE_URL=
OJS_API_KEY=

# Required for the `ojs reviews fetch` / `ojs articles fetch` commands, which log
# in and download the OJS dashboard report CSVs. The report URLs are
# instance-specific (they vary by OJS install and version); each may be given
# absolute or as a path relative to OJS_BASE_URL.
OJS_USERNAME=
OJS_PASSWORD=
OJS_REVIEWS_REPORT_URL=
OJS_ARTICLES_REPORT_URL=

# Optional -- output directory overrides (defaults shown)
OJS_DOWNLOADS_DIR=data/ojs-website
OJS_API_DIR=data/ojs-api
